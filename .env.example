# Environment variables for running the projects under examples/.
# Copy the values you need into your shell environment before running an example.

# examples/json_storage
PYTEST_RUN_CONTEXT_JSON_DIRECTORY=/tmp/pytest-run-context-example/json

# examples/sqlite_storage
PYTEST_RUN_CONTEXT_SQLITE_PATH=/tmp/pytest-run-context-example/runs.sqlite3

# examples/external_preparation
PYTEST_RUN_CONTEXT_EXTERNAL_DB=/tmp/pytest-run-context-external-preparation.sqlite3

# examples/redis_storage
# Add credentials only to your local .env file when Redis requires them.
PYTEST_RUN_CONTEXT_REDIS_URL=redis://localhost
PYTEST_RUN_CONTEXT_REDIS_PORT=6379
PYTEST_RUN_CONTEXT_REDIS_DB=0
PYTEST_RUN_CONTEXT_REDIS_USERNAME=
PYTEST_RUN_CONTEXT_REDIS_PASSWORD=
PYTEST_RUN_CONTEXT_REDIS_TTL=86400
PYTEST_RUN_CONTEXT_REDIS_RETRIES=3
PYTEST_RUN_CONTEXT_REDIS_BACKOFF_BASE=0.008
PYTEST_RUN_CONTEXT_REDIS_BACKOFF_CAP=0.512
